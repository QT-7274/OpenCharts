# Default: live Binance Spot public market data. No API key is required.
VITE_MARKET_DATA_MODE=binance
VITE_BINANCE_REST_BASE_URL=https://data-api.binance.vision/api/v3
VITE_BINANCE_WS_BASE_URL=wss://data-stream.binance.vision

# Use VITE_MARKET_DATA_MODE=demo to replay the bundled historical dataset offline.

# Optional local AI explanation server. Keep this key server-only (no VITE_ prefix).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENCHARTS_AI_PORT=3000
# Optional; defaults to ~/.opencharts/ai-usage.json.
OPENCHARTS_AI_USAGE_PATH=
